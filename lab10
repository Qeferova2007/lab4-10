import math

def f(x):
    return (math.exp(x) - 1) / (x - 1)

def df(x):
    numerator = math.exp(x) * (x - 1) - (math.exp(x) - 1)
    denominator = (x - 1) ** 2
    return numerator / denominator

def newton_method(x0, eps=1e-5, max_iter=1000):
    for i in range(max_iter):
        fx = f(x0)
        dfx = df(x0)
        if dfx == 0:
            print("Törəmə sıfır oldu. Nyuton metodu dayandı.")
            return None
        x1 = x0 - fx / dfx
        if abs(x1 - x0) < eps:
            return x1
        x0 = x1
    print("Konvergensiya alınmadı.")
    return None


x0 = 0.8

root = newton_method(x0)

if root is not None:
    print(f"Təqribi kök (Nyuton üsulu): x = {root:.5f}")
